# Plantilla de configuración. Copiala a `.env` (que está en .gitignore) y poné los valores reales.
#
# El plugin de secrets inyecta cada clave de acá como campo de BuildConfig; se leen desde
# `com.example.data.AppConfig`. Los valores de este archivo son SOLO el fallback para que el
# proyecto compile sin `.env`: con ellos la app arranca en Modo Local (Demo).
#
# En CI, el workflow de release escribe `.env` a partir de los secrets del repo
# (SCRIPT_URL / DRIVE_FOLDER_ID) antes de compilar.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# URL del Web App de Google Apps Script (deployment /exec).
# Cualquiera que tenga esta URL puede leer y escribir la planilla: NO la subas al repo.
SCRIPT_URL=

# ID de la carpeta de Google Drive donde se guardan los tickets.
DRIVE_FOLDER_ID=
